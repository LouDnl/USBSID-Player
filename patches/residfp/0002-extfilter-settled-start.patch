diff -ruN a/ExternalFilter.h b/ExternalFilter.h
--- a/ExternalFilter.h	2026-10-31 18:50:27.319697817 +0100
+++ b/ExternalFilter.h	2026-10-31 18:50:27.339487186 +0100
@@ -94,6 +94,9 @@
     /// Highpass filter voltage
     int32_t Vhp;
 
+    /// False after reset, the first clock() settles the filter on its input
+    bool primed = false;
+
     int32_t w0lp_1_s7 = 0;
 
     int32_t w0hp_1_s17 = 0;
@@ -150,6 +153,12 @@
 int32_t ExternalFilter::clock(int32_t input)
 {
     const int32_t Vi = input << 11;
+    if (unlikely(!primed))
+    {
+        // Start settled, no DC step tick at the first sample
+        Vlp = Vhp = Vi;
+        primed = true;
+    }
     const int32_t dVlp = (w0lp_1_s7 * (Vi - Vlp)) >> 7;
     const int32_t dVhp = (w0hp_1_s17 * (Vlp - Vhp)) >> 17;
     Vlp += dVlp;
